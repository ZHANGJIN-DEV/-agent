# ============================================================
# PanoDirector 环境变量模板
# 复制为 .env 并填入真实 key。.env 已被 .gitignore 忽略。
#   cp .env.example .env
# ============================================================

# ---- DeepSeek：一个平台同时覆盖 LLM 与 VLM ----
# 申请: https://platform.deepseek.com/
# 实测（2026-09）：deepseek-chat 与 deepseek-flash 均支持**图像输入**；
#   deepseek-flash 额外返回 reasoning_content（推理过程）。
#   deepseek-v4-pro 当前不支持视觉，勿用于 VLM。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat        # 文本规划
DEEPSEEK_VL_MODEL=deepseek-flash    # 视觉理解（带推理）

# ---- 备选 VLM 平台（DeepSeek 已够用时留空即可）----
# 通义千问 DashScope: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
QWEN_VL_MODEL=qwen-vl-plus
QWEN_LLM_MODEL=qwen-plus

# 智谱 GLM: https://open.bigmodel.cn/   GLM-4V-Flash / GLM-4.5-Flash 免费
ZHIPU_API_KEY=
GLM_VL_MODEL=glm-4v-flash
GLM_LLM_MODEL=glm-4.5-flash

# ---- 默认提供商（deepseek | qwen | zhipu | mock）----
# mock = 离线假响应，用于单元测试和 CI，不消耗任何额度
PANODIRECTOR_LLM_PROVIDER=deepseek
PANODIRECTOR_VLM_PROVIDER=deepseek

# ---- 数据与缓存路径（Windows 下数据放 C 盘，D 盘空间不足）----
PANO_DATA_ROOT=C:/pano_data
PANO_CACHE_ROOT=C:/pano_data/cache

# ---- 运行设备 ----
# cuda | cpu | auto   （RTX 3050 4GB，实际可用约 2.5GB）
PANO_DEVICE=auto

# ---- HuggingFace 镜像（国内加速）----
HF_ENDPOINT=https://hf-mirror.com
